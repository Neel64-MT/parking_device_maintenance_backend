PORT=5000

# PostgreSQL (discrete settings)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_NAME=parking_device_maintenance

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:5173
# Optional public URL for password-reset links (defaults to FRONTEND_ORIGIN)
# APP_URL=http://localhost:5173

# Optional SMTP for forgot-password emails (omit in local dev → console link)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=noreply@example.com

UPLOAD_DIR=uploads
NODE_ENV=development

# Browser Web Push (generate once with `npx web-push generate-vapid-keys`)
# Keep the private key server-side; expose only the public key to the frontend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Use mailto:admin@example.com or an https:// contact URL.
VAPID_SUBJECT=

# SmartPark Device Sync
DEVICE_SYNC_BASE_URL=https://v2smartpark.mtapps.in/api/v1/engineer/device-binding
# Paste the Postman Authorization token (with or without "Bearer " prefix)
DEVICE_SYNC_API_TOKEN=
# Optional override for get-slot-mac (defaults to …/api/v1 derived from DEVICE_SYNC_BASE_URL)
# SMARTPARK_API_BASE_URL=https://v2smartpark.mtapps.in/api/v1